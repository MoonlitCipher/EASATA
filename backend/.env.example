# Copy to .env (optional). Every value has a safe default.

# Where the frontend's /respond page lives (links in "Was this you?" emails point here)
PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bank-operations key for /api/ops/* (X-Ops-Key header). If empty, one is generated into data/ops_api_key.txt
OPS_API_KEY=

# Demo delivery: messages are always stored in the in-app outbox (GET /api/demo/inbox).
DEMO_MODE=1
DEMO_EMAIL=customer@example.test
DEMO_PHONE=+91-90000-00000

# Optional real SMTP (Mailpit: docker run -p 8025:8025 -p 1025:1025 axllent/mailpit, then open http://localhost:8025)
SMTP_ENABLED=1
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=0

TOKEN_TTL_MIN=30
OTP_TTL_MIN=5
TRUSTED_PATTERN_DAYS=14
# 0 = derive from the bundle (threshold x 95th-percentile amount)
EXPECTED_LOSS_HIGH=0

# EASATA simulation alert emails (Simulate → Alerts → "Send now", or automatic after each run).
# Alerts go only to this address. To deliver them to a real Gmail inbox, use Gmail SMTP with an app password
# (Google Account -> Security -> 2-Step Verification -> App passwords), then restart the backend:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=1
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASSWORD=your-16-letter-app-password
EASATA_EMAIL_TO=customer@example.test

# NVIDIA Nemotron on Nebius Token Factory / Nebius AI Studio
# Obtain your key from https://studio.nebius.ai/
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct

# Optional Tavily API Key for real-time merchant scam/reputation intelligence
TAVILY_API_KEY=
